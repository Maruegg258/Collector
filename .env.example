# HYPE Spot Collector example configuration
# Copy to .env for local use. Never commit real credentials.

PORT=8000
STORAGE_BACKEND=sqlite
DB_PATH=./data/hype_spot.sqlite3

# Required only for PostgreSQL:
# DATABASE_URL=postgresql://user:password@host:5432/database

# Optional unique identity for PostgreSQL continuity leases.
# If omitted, HOSTNAME is used when available, otherwise a generated local UUID.
# COLLECTOR_INSTANCE_ID=collector-1

HYPE_COIN=@107
HYPERLIQUID_WS_URL=wss://api.hyperliquid.xyz/ws
RAW_RETENTION_HOURS=12
SUMMARY_INTERVAL_SECONDS=60
STORAGE_MAINTENANCE_INTERVAL_SECONDS=3600
READINESS_MAX_MESSAGE_AGE_MS=30000
LOG_LEVEL=INFO
